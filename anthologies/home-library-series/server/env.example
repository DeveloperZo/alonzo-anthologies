# Settings for the home library server. The real file is .env, which git ignores.
# Copy this to .env and replace every CHANGEME with a random value.

# The address you open Langfuse at.
NEXTAUTH_URL=http://win-mpisa5dbmqf:3000
# Langfuse usage reporting to its makers.
TELEMETRY_ENABLED=false
# Your Langfuse login. Fill in before the first start.
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=Zo
# At least 8 characters. Fill in before the first start.
LANGFUSE_INIT_USER_PASSWORD=
# Created on first start so the relay has keys without a manual step.
LANGFUSE_INIT_ORG_ID=home-library
LANGFUSE_INIT_ORG_NAME=Home Library
LANGFUSE_INIT_PROJECT_ID=home-library
LANGFUSE_INIT_PROJECT_NAME=Home Library

# Secrets. Random values, used only between the containers.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=CHANGEME
LITELLM_MASTER_KEY=CHANGEME
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME
NEXTAUTH_SECRET=CHANGEME
POSTGRES_PASSWORD=CHANGEME
CLICKHOUSE_PASSWORD=CHANGEME
REDIS_AUTH=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME
# Must repeat the passwords above.
DATABASE_URL=postgresql://postgres:CHANGEME@postgres:5432/postgres
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=CHANGEME
