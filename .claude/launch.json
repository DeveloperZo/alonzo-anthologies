{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "resume-spa",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start", "--prefix", "resumeContent"],
      "port": 3000
    },
    {
      "name": "site",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd site && npx quartz build --serve --port 8080"],
      "port": 8080,
      "autoPort": false
    }
  ]
}
